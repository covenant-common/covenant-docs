{
  "profile": "urn:aap:levels:0.2",
  "note": "Placement orders features; it never grants authority, changes a signed meaning or removes a feature.",
  "order": [
    "ORGANON",
    "L0",
    "L1",
    "L2",
    "L3",
    "L4"
  ],
  "core_levels": [
    "ORGANON",
    "L0",
    "L1",
    "L2",
    "L3"
  ],
  "levels": [
    {
      "id": "ORGANON",
      "name": "Organon",
      "cause": "instrument",
      "question": "How does an agent find its way?",
      "scope": "Onboarding, navigation, explanation, servers, command lines, configuration and demonstrations. Instruments serve every level and hold no authority."
    },
    {
      "id": "L0",
      "name": "Matter",
      "cause": "material",
      "question": "What is an agreement made of?",
      "scope": "Canonical bytes, hashes and content identifiers, signature suites, keys and identities, proofs, privacy envelopes, time and place evidence, and the carriers that move bytes (files, QR, NFC, Bluetooth, mesh radio)."
    },
    {
      "id": "L1",
      "name": "Form",
      "cause": "formal",
      "question": "What is the agreement?",
      "scope": "The envelope: identified parties, exact typed terms and acceptance criteria, negotiation, meaning echoes, pre-signature checks, assent by authorised parties, revision and supersession."
    },
    {
      "id": "L2",
      "name": "Act",
      "cause": "efficient",
      "question": "How does the promise become performance?",
      "scope": "Delivery, payment legs and rails (manual, AAP escrow, AP2, x402), tool-call and outcome receipts, bindings to MCP and A2A, effects and adapters."
    },
    {
      "id": "L3",
      "name": "Justice",
      "cause": "corrective",
      "question": "How is a broken promise made right?",
      "scope": "Evidence, the dispute ladder from optimistic claim to negotiation, arbitrator, panel and appeal, bonds, remedies and reviewed outcomes."
    },
    {
      "id": "L4",
      "name": "Polis",
      "cause": "final",
      "question": "How do many agreements live together?",
      "scope": "Reputation, discovery and requests, markets, auctions and ads, organisations and mandates at scale, witnesses and the shared ledger, economics, governance and research extensions."
    }
  ],
  "categories": [
    {
      "id": "substance",
      "meaning": "Who: parties, roles and identities"
    },
    {
      "id": "quantity",
      "meaning": "How much: amounts, units and counts"
    },
    {
      "id": "quality",
      "meaning": "What kind: specifications and acceptance criteria"
    },
    {
      "id": "relation",
      "meaning": "Towards whom: beneficiaries, delegation, precedence, supersession"
    },
    {
      "id": "place",
      "meaning": "Where: delivery point, location evidence, seat or jurisdiction"
    },
    {
      "id": "time",
      "meaning": "When: deadlines and windows, judged as evidence intervals"
    },
    {
      "id": "position",
      "meaning": "In what state: each obligation’s lifecycle state"
    },
    {
      "id": "having",
      "meaning": "Held how: escrow, custody, collateral"
    },
    {
      "id": "action",
      "meaning": "Doing: deliver, pay, notify, perform"
    },
    {
      "id": "affection",
      "meaning": "Being done to: receive, accept, dispute, be bound"
    }
  ],
  "species": [
    {
      "id": "exchange",
      "differentia": "goods or digital items for value"
    },
    {
      "id": "service",
      "differentia": "work for value"
    },
    {
      "id": "credit",
      "differentia": "value now for value later"
    },
    {
      "id": "licence",
      "differentia": "use of a right for value"
    },
    {
      "id": "risk",
      "differentia": "value contingent on an uncertain event"
    },
    {
      "id": "association",
      "differentia": "a common purpose among members"
    },
    {
      "id": "agency",
      "differentia": "acting for another within limits"
    },
    {
      "id": "legal-instrument",
      "differentia": "a composed legal document with its own assent rules"
    }
  ],
