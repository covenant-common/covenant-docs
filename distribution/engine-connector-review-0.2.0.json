  "protocolVersion": "2025-11-25",
  "observation": "distribution/engine-mcp-observation-2026-11-14.f6.v1.json",
  "inventory": "mcp/engine-tool-inventory-2026-11-14.f6.v1.json",
  "steps": "Each request is the params object of tools/call after initialize and tools/list. Compare expect with the parsed tool response. The cases use public data or fictional inputs and no private account.",
  "evidence": "Expected synthetic reviewer outcomes. Native installation, model tool selection and store acceptance require separate checks.",
  "test_cases": {
    "positive": [
      {
        "id": "start",
        "description": "Get the current public routes",
        "prompt": "What can Covenant do here? Find the free actions and explain which actions need a separate account.",
        "steps": [
          {
            "request": {
              "name": "covenant_onboard",
              "arguments": {}
            },
            "expect": {
              "profile": "urn:aap:hosted-engine-mcp:0.2",
              "keys_accepted": false
            }
          }
        ]
      },
      {
        "id": "find-service",
        "description": "Find a real published service",
        "prompt": "Find public research services. Show test listings separately and say if there are no available matches.",
        "steps": [
          {
            "request": {
              "name": "covenant_find",
              "arguments": {
                "kind": "services",
                "query": "research",
                "limit": 5,
                "include_test": true
              }
            },
            "expect": {
              "signed": false,
              "paid": false,
              "published": false
            }
          }
        ]
      },
      {
        "id": "draft-terms",
        "description": "Draft an unsigned USD 25 brief",
        "prompt": "Draft a USD 25 research brief for the sample buyer and supplier, due in three days, with buyer review. Keep it unsigned.",
        "steps": [
          {
            "request": {
              "name": "covenant_find",
              "arguments": {
                "kind": "features",
                "query": "covenant_contract__draft",
                "limit": 5
              }
            },
            "expect": {
              "metadata_only": true,
              "execution_authorized": false
            }
          },
          {
            "request": {
              "name": "covenant_explain",
              "arguments": {
                "tool": "covenant_contract__draft"
              }
            },
            "expect": {
              "available_here": true,
              "name": "covenant_contract__draft",
              "execution_authorized": false
            }
          },
          {
            "request": {
              "name": "covenant_call",
              "arguments": {
                "tool": "covenant_contract__draft",
                "arguments": {
                  "title": "Synthetic review: one research brief",
                  "parties": [
                    "buyer-example",
                    "supplier-example"
                  ],
                  "clauses": [
                    {
                      "id": "scope",
                      "title": "Work",
                      "text": "One page answering the agreed research question, with sources."
                    },
                    {
                      "id": "price",
                      "title": "Price",
                      "text": "USD 25. This is an unsigned synthetic exercise; no payment is authorised."
                    },
                    {
                      "id": "deadline",
                      "title": "Deadline",
                      "text": "Deliver the brief within three days after both parties approve the terms."
                    },
                    {
                      "id": "review",
                      "title": "Delivery review",
                      "text": "The buyer checks the brief against the exact agreed scope before accepting it."
                    }
                  ]
                }
              }
            },
            "expect": {
              "status": "UNSIGNED_DRAFT",
              "binding": false,
              "execution_authorized": false,
              "draft": {
                "title": "Synthetic review: one research brief",
                "clauses": [
                  {
                    "id": "scope",
                    "title": "Work",
                    "text": "One page answering the agreed research question, with sources."
                  },
                  {
                    "id": "price",
                    "title": "Price",
                    "text": "USD 25. This is an unsigned synthetic exercise; no payment is authorised."
                  },
                  {
                    "id": "deadline",
                    "title": "Deadline",
                    "text": "Deliver the brief within three days after both parties approve the terms."
                  },
                  {
                    "id": "review",
                    "title": "Delivery review",
                    "text": "The buyer checks the brief against the exact agreed scope before accepting it."
                  }
                ]
              }
            }
          }
        ]
      },
      {
