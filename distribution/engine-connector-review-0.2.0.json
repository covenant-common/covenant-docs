        "prompt": "Compare the two sample research terms. Show the USD 25 to USD 30 price change and tell me what needs fresh approval.",
        "steps": [
          {
            "request": {
              "name": "covenant_explain",
              "arguments": {
                "tool": "covenant_contract__compare"
              }
