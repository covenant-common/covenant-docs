              "execution_authorized": false
            }
          }
        ]
      },
      {
        "id": "check-evidence",
        "description": "Check a record with no supplied proofs",
        "prompt": "Check the sample case with no attached proofs. Tell me what is verified and what still needs proof.",
        "steps": [
          {
            "request": {
              "name": "covenant_explain",
              "arguments": {
                "tool": "covenant_review__evidence"
