    {
      "action": "resolve",
      "allow": true,
      "next": "resolved",
      "next_refund": "refunded",
      "role": "resolver",
      "scope": "deal:resolve",
      "state": "disputed"
    },
    {
      "action": "evidence",
      "allow": true,
      "role": "buyer",
